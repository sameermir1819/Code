# Database connection string
# For instant zero-dependency local development (SQLite):
DATABASE_URL="file:./dev.db"

# For PostgreSQL in production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/coaching_erp?schema=public"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-long"
NEXTAUTH_SECRET="super-secret-nextauth-key-replace-in-production-long"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_NAME="Apex Academy Coaching ERP"
NEXT_PUBLIC_APP_CURRENCY="INR"
NEXT_PUBLIC_APP_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
