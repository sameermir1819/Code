generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// INSTITUTE & ACADEMIC SESSION
// -------------------------------------------------------------
model Institute {
  id               String            @id @default(cuid())
  name             String            @default("Futurex Learning")
  code             String            @unique @default("FL-CAMPUS-01")
  tagline          String?           @default("Excellence in Academic Coaching & Competitive Entry Test Prep")
  address          String?           @default("Plot 42, Knowledge Park, Central Avenue")
  city             String?           @default("New Delhi")
  state            String?           @default("Delhi")
  phone            String?           @default("+91 98765 43210")
  email            String?           @default("admissions@futurexlearning.com")
  website          String?           @default("https://futurexlearning.com")
  logoUrl          String?
  currency         String            @default("INR")
  currencySymbol   String            @default("₹")
  timezone         String            @default("Asia/Kolkata")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  academicSessions AcademicSession[]
  users            User[]
  courses          Course[]
  batches          Batch[]
  students         Student[]
  teachers         Teacher[]
  auditLogs        AuditLog[]
  leads            Lead[]
}

model AcademicSession {
  id          String    @id @default(cuid())
  instituteId String
  name        String    // e.g. "2025-2026"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batches     Batch[]
  students    Student[]

  @@index([instituteId])
}

// -------------------------------------------------------------
// USERS & AUTHENTICATION
// Roles: SUPER_ADMIN, ADMIN, ACCOUNTANT, TEACHER, STUDENT, PARENT
// -------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  instituteId  String?
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("STUDENT") // SUPER_ADMIN, ADMIN, ACCOUNTANT, TEACHER, STUDENT, PARENT
  avatarUrl    String?
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  branch       String?
  notes        String?
  isArchived   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  institute    Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  teacher      Teacher?
  student      Student?
  parent       Parent?
  auditLogs    AuditLog[]
  notifications Notification[]
  announcements Announcement[] @relation("CreatedAnnouncements")
  userRoles    UserRole[]
  userPermissions UserPermission[]

  @@index([role])
  @@index([email])
  @@index([status])
  @@index([isArchived])
}

// -------------------------------------------------------------
// RELATIONAL RBAC: ROLES & PERMISSIONS
// -------------------------------------------------------------
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, ACCOUNTANT, TEACHER, STUDENT, PARENT
  displayName String   // "Super Administrator", "Administrator", etc.
  description String?
  isSystem    Boolean  @default(true) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "users.view", "users.create", "fees.view"
  name        String   // "View Users"
  module      String   // "users", "students", "academics", "finance", etc.
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true) // true = grant, false = revoke override
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// -------------------------------------------------------------
// TEACHERS
// -------------------------------------------------------------
model Teacher {
  id             String    @id @default(cuid())
  instituteId    String
  userId         String?   @unique
  teacherId      String    @unique // e.g. "TCH-001"
  name           String
  email          String
  phone          String
  gender         String?   @default("OTHER")
  address        String?
  qualification  String?   // e.g. "M.Sc Physics, B.Ed"
  specialization String?   // e.g. "Quantum Mechanics, Advanced Calculus"
  joiningDate    DateTime  @default(now())
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  photoUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjects       TeacherSubject[]
  batches        TeacherBatch[]
  timetableSlots TimetableSlot[]
  studyMaterials StudyMaterial[]

  @@index([instituteId])
}

// -------------------------------------------------------------
// PARENTS
// -------------------------------------------------------------
model Parent {
  id           String    @id @default(cuid())
  userId       String?   @unique
  name         String
  relation     String    @default("Father") // Father, Mother, Guardian
  phone        String
  email        String?
  occupation   String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  students     Student[]

  @@index([phone])
}

// -------------------------------------------------------------
// STUDENTS
// -------------------------------------------------------------
model Student {
  id                  String           @id @default(cuid())
  instituteId         String
  userId              String?          @unique
  parentId            String?
  sessionId           String?
  studentId           String           @unique // e.g. "STU-2026-001"
  admissionNo         String           @unique // e.g. "ADM-2026-001"
  name                String
  email               String?
  phone               String?
  dob                 DateTime?
  gender              String           @default("MALE") // MALE, FEMALE, OTHER
  address             String?
  city                String?          @default("New Delhi")
  state               String?          @default("Delhi")
  emergencyContact    String?
  schoolCollege       String?
  gradeClass          String?          // e.g. "Class 11", "Class 12", "Repeater"
  previousInstitution String?
  admissionDate       DateTime         @default(now())
  joiningDate         DateTime         @default(now())
  status              String           @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, COMPLETED, DROPPED
  notes               String?
  photoUrl            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  institute           Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent              Parent?          @relation(fields: [parentId], references: [id], onDelete: SetNull)
  session             AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  enrollments         Enrollment[]
  attendances         Attendance[]
  feePlans            FeePlan[]
  payments            Payment[]
  marks               Marks[]
  documents           Document[]
  studyMaterials      StudentStudyMaterial[]

  @@index([instituteId])
  @@index([status])
  @@index([admissionNo])
}

// -------------------------------------------------------------
// COURSES & SUBJECTS
// -------------------------------------------------------------
model Course {
  id              String           @id @default(cuid())
  instituteId     String
  name            String           // e.g. "IIT-JEE Advanced 2-Year Program"
  code            String           @unique // e.g. "JEE-ADV-2Y"
  description     String?
  duration        String           @default("2 Years")
  gradeClass      String?          @default("Class 11 & 12")
  standardFee     Float            @default(120000)
  registrationFee Float            @default(5000)
  status          String           @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  institute       Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subjects        CourseSubject[]
  batches         Batch[]
  enrollments     Enrollment[]
  studyMaterials  StudyMaterial[]
  announcements   Announcement[]

  @@index([instituteId])
}

model Subject {
  id             String           @id @default(cuid())
  name           String           // e.g. "Physics", "Inorganic Chemistry", "Calculus"
  code           String           @unique // e.g. "PHY-101"
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  courses        CourseSubject[]
  teachers       TeacherSubject[]
  timetableSlots TimetableSlot[]
  exams          Exam[]
  studyMaterials StudyMaterial[]
}

model CourseSubject {
  id        String   @id @default(cuid())
  courseId  String
  subjectId String
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([courseId, subjectId])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

// -------------------------------------------------------------
// BATCHES
// -------------------------------------------------------------
model Batch {
  id          String          @id @default(cuid())
  instituteId String
  courseId    String
  sessionId   String?
  name        String          // e.g. "Apex Super-30 Batch A"
  code        String          @unique // e.g. "BAT-2026-JEE-A"
  startDate   DateTime
  endDate     DateTime
  capacity    Int             @default(40)
  room        String?         @default("Lecture Hall 1")
  status      String          @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED, ARCHIVED
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  institute   Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session     AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  teachers       TeacherBatch[]
  enrollments    Enrollment[]
  timetableSlots TimetableSlot[]
  attendances    Attendance[]
  exams          Exam[]
  studyMaterials StudyMaterial[]
  announcements  Announcement[]

  @@index([courseId])
  @@index([status])
}

model TeacherBatch {
  id        String   @id @default(cuid())
  teacherId String
  batchId   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([teacherId, batchId])
}

// -------------------------------------------------------------
// ENROLLMENTS (Historical lifecycle)
// -------------------------------------------------------------
model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  batchId     String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE, TRANSFERRED, COMPLETED, DROPPED
  source      String?   @default("DIRECT_ADMISSION") // DIRECT_ADMISSION, SCHOLARSHIP_TEST, REFERRAL
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  feePlans    FeePlan[]

  @@index([studentId])
  @@index([batchId])
  @@index([status])
}

// -------------------------------------------------------------
// TIMETABLE
// -------------------------------------------------------------
model TimetableSlot {
  id        String   @id @default(cuid())
  dayOfWeek String   // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "10:30"
  batchId   String
  subjectId String
  teacherId String
  room      String   @default("Room 101")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([teacherId])
  @@index([dayOfWeek])
}

// -------------------------------------------------------------
// ATTENDANCE
// -------------------------------------------------------------
model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  batchId    String
  date       DateTime
  status     String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  markedBy   String?  // user name or ID
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId, date])
  @@index([batchId, date])
  @@index([studentId])
}

// -------------------------------------------------------------
// FINANCE: FEE PLANS, INSTALLMENTS, PAYMENTS, REFUNDS
// -------------------------------------------------------------
model FeePlan {
  id             String           @id @default(cuid())
  studentId      String
  enrollmentId   String?
  title          String           @default("Standard Course Fee Plan")
  admissionFee   Float            @default(10000)
  tuitionFee     Float            @default(80000)
  materialFee    Float            @default(10000)
  examFee        Float            @default(5000)
  otherCharges   Float            @default(0)
  totalAmount    Float            @default(105000)
  discountAmount Float            @default(0)
  discountReason String?
  finalAmount    Float            @default(105000)
  paidAmount     Float            @default(0)
  balanceAmount  Float            @default(105000)
  status         String           @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment     Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  installments   FeeInstallment[]
  payments       Payment[]

  @@index([studentId])
  @@index([status])
}

model FeeInstallment {
  id                String    @id @default(cuid())
  feePlanId         String
  installmentNumber Int
  title             String    // e.g. "Installment 1 (At Admission)"
  dueDate           DateTime
  amount            Float
  paidAmount        Float     @default(0)
  remainingAmount   Float
  status            String    @default("UPCOMING") // UPCOMING, DUE, PARTIAL, PAID, OVERDUE
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  feePlan           FeePlan   @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@index([feePlanId])
  @@index([dueDate])
  @@index([status])
}

model Payment {
  id             String            @id @default(cuid())
  receiptNo      String            @unique // e.g. "REC-2026-0001"
  studentId      String
  feePlanId      String
  installmentId  String?
  amount         Float
  paymentMethod  String            @default("UPI") // CASH, UPI, BANK_TRANSFER, CARD, OTHER
  paymentDate    DateTime          @default(now())
  collectedBy    String            @default("Accounts Desk")
  referenceNo    String?           // Transaction / Cheque / UTR ID
  notes          String?
  status         String            @default("SUCCESS") // SUCCESS, REFUNDED, ADJUSTED
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePlan        FeePlan           @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  installment    FeeInstallment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  refunds        RefundAdjustment[]

  @@index([studentId])
  @@index([receiptNo])
  @@index([paymentDate])
}

model RefundAdjustment {
  id          String   @id @default(cuid())
  paymentId   String
  type        String   @default("REFUND") // REFUND, ADJUSTMENT
  amount      Float
  reason      String
  approvedBy  String   @default("Super Admin")
  refundDate  DateTime @default(now())
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// -------------------------------------------------------------
// EXAMS & MARKS
// -------------------------------------------------------------
model Exam {
  id              String     @id @default(cuid())
  title           String     // e.g. "Phase 1 Assessment - Physics Mechanics"
  code            String     @unique // e.g. "EXAM-2026-P1"
  type            String     @default("TEST") // TEST, EXAM, ASSIGNMENT, MOCK_TEST
  batchId         String
  subjectId       String
  examDate        DateTime
  maxMarks        Float      @default(100)
  passingMarks    Float      @default(40)
  durationMinutes Int        @default(180)
  instructions    String?
  status          String     @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, PUBLISHED
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  batch           Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject         Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks           Marks[]

  @@index([batchId])
  @@index([subjectId])
}

model Marks {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  marksObtained Float
  percentage    Float
  grade         String   // A+, A, B+, B, C, F
  isPassed      Boolean  @default(true)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
}

// -------------------------------------------------------------
// STUDY MATERIAL & DOCUMENTS
// -------------------------------------------------------------
model StudyMaterial {
  id             String                 @id @default(cuid())
  title          String
  description    String?
  fileType       String                 @default("PDF") // PDF, DOCUMENT, IMAGE, LINK, ASSIGNMENT
  fileUrl        String
  fileSize       String?                @default("2.4 MB")
  courseId       String?
  batchId        String?
  subjectId      String?
  uploadedById   String?
  downloadsCount Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  course         Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batch          Batch?                 @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subject        Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploadedBy     Teacher?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  assignedTo     StudentStudyMaterial[]

  @@index([courseId])
  @@index([batchId])
  @@index([subjectId])
}

model StudentStudyMaterial {
  id              String        @id @default(cuid())
  studyMaterialId String
  studentId       String
  downloadedAt    DateTime?
  createdAt       DateTime      @default(now())

  studyMaterial   StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studyMaterialId, studentId])
}

model Document {
  id           String   @id @default(cuid())
  studentId    String
  title        String
  docType      String   @default("ID_PROOF") // PHOTO, ID_PROOF, MARKSHEET, ADMISSION_DOC, OTHER
  fileUrl      String
  fileSize     String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// -------------------------------------------------------------
// NOTIFICATIONS & ANNOUNCEMENTS
// -------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL") // FEE_DUE, PAYMENT_RECEIVED, ATTENDANCE_WARNING, EXAM_ANNOUNCED, RESULT_PUBLISHED, STUDY_MATERIAL, GENERAL
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  message     String
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  targetRole  String    @default("ALL") // ALL, TEACHER, STUDENT, PARENT
  courseId    String?
  batchId     String?
  publishDate DateTime  @default(now())
  expiryDate  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([targetRole])
}

// -------------------------------------------------------------
// AUDIT LOG
// -------------------------------------------------------------
model AuditLog {
  id          String    @id @default(cuid())
  instituteId String?
  userId      String?
  userName    String?
  userRole    String?
  action      String    // e.g. "STUDENT_CREATED", "ATTENDANCE_MARKED", "PAYMENT_RECORDED"
  entity      String    // "Student", "Payment", "Attendance", etc.
  entityId    String?
  details     String?   // JSON string or descriptive text
  ipAddress   String?
  createdAt   DateTime  @default(now())

  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// -------------------------------------------------------------
// ADMISSIONS CRM: LEADS, QUERIES & FOLLOW-UPS
// -------------------------------------------------------------
model Lead {
  id                 String         @id @default(cuid())
  instituteId        String?
  name               String         // Student / Inquirer Name
  phone              String         // Contact Phone
  email              String?        // Optional email
  parentName         String?        // Father/Mother name
  parentPhone        String?        // Parent Contact
  courseInterest     String?        // e.g. "NEET Dropper Batch", "JEE Advanced 2-Yr"
  currentClass       String?        // e.g. "Class 11", "Class 12", "Repeater"
  currentSchool      String?        // e.g. "Burn Hall", "DPS", "Govt HSS"
  source             String         @default("WALK_IN") // WALK_IN, WEBSITE, CALL, SOCIAL_MEDIA, REFERRAL, NEWSPAPER, OTHER
  status             String         @default("NEW") // NEW, CONTACTED, COUNSELING_SCHEDULED, TRIAL_CLASS, CONVERTED, LOST
  priority           String         @default("MEDIUM") // LOW, MEDIUM, HIGH, HOT
  assignedTo         String?        // Staff / Counselor Name
  nextFollowUp       DateTime?      // Next scheduled follow-up
  notes              String?        // Remarks or background info
  isConverted        Boolean        @default(false)
  convertedStudentId String?        // Link to admitted student ID if converted
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  institute          Institute?     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  followUps          LeadFollowUp[]

  @@index([instituteId])
  @@index([status])
  @@index([phone])
  @@index([nextFollowUp])
}

model LeadFollowUp {
  id            String    @id @default(cuid())
  leadId        String
  date          DateTime  @default(now())
  scheduledFor  DateTime?
  status        String    @default("COMPLETED") // COMPLETED, SCHEDULED, MISSED, CANCELLED
  contactMethod String    @default("PHONE_CALL") // PHONE_CALL, WHATSAPP, IN_PERSON, EMAIL, SMS
  notes         String    // Discussion summary, objections, next steps
  counselorName String?
  createdAt     DateTime  @default(now())

  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

